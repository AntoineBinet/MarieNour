{
  "name": "marienour",
  "version": "36.0.0",
  "private": true,
  "description": "marienour — l'atelier personnel pour tout garder, planifier et partager. Dashboard à widgets, multi-utilisateurs, semi-social. Hébergé sur Cloudflare.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "wrangler pages dev --port 8788 --persist-to .wrangler/state",
    "build": "vite build",
    "build:server": "esbuild server/node.ts --bundle --platform=node --format=esm --target=node20 --packages=external --tsconfig=tsconfig.server.json --outfile=dist-server/server.mjs",
    "build:all": "npm run build && npm run build:server",
    "start": "node dist-server/server.mjs",
    "start:prod": "node dist-server/server.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.server.json",
    "deploy": "npm run build && wrangler pages deploy dist",
    "db:migrate:local": "wrangler d1 migrations apply marienour --local --persist-to .wrangler/state",
    "db:migrate": "wrangler d1 migrations apply marienour --remote"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.1.0",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hono/node-server": "^1.13.7",
    "@tanstack/react-query": "^5.59.0",
    "better-sqlite3": "^11.8.1",
    "hono": "^4.6.3",
    "nodemailer": "^6.9.16",
    "qrcode-generator": "^1.5.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241004.0",
    "@types/qrcode-generator": "^0.0.16",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^4.3.2",
    "esbuild": "^0.24.2",
    "typescript": "^5.6.2",
    "vite": "^5.4.8",
    "vitest": "^2.1.9",
    "wrangler": "^3.80.0"
  }
}
