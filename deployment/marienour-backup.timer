# marienour · déclenche la sauvegarde chaque nuit (cf. marienour-backup.service).
# 03:30 UTC, un quart d'heure avant celle de Portfolio (03:45 UTC) : les deux
# ne se chevauchent pas sur une machine partagée.

[Unit]
Description=marienour · sauvegarde quotidienne vers R2 (03:30 UTC)

[Timer]
OnCalendar=*-*-* 03:30:00 UTC
RandomizedDelaySec=300
AccuracySec=1min
# Rattrapage au démarrage si la machine était éteinte à l'heure prévue.
Persistent=true

[Install]
WantedBy=timers.target
