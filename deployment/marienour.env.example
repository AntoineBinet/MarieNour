# marienour — variables d'environnement de PRODUCTION (VM Oracle).
#
# Sur la VM, copier ce fichier vers /etc/marienour/marienour.env, le remplir,
# puis le verrouiller :
#   sudo install -m600 -o root -g root deployment/marienour.env.example /etc/marienour/marienour.env
#   sudo nano /etc/marienour/marienour.env      # remplir les valeurs
#   sudo systemctl restart marienour
#
# ⚠️ NE JAMAIS committer ce fichier rempli. Les secrets restent côté serveur.

# ── Compte admin (toi) ─────────────────────────────────────────────────────
# Au tout premier login avec ADMIN_EMAIL + ADMIN_PASSWORD, le compte admin est
# créé automatiquement (rôle admin garanti). Ensuite, ADMIN_PASSWORD reste le
# « mot de passe maître » du compte propriétaire.
ADMIN_EMAIL=binet.antoine215@yahoo.com
ADMIN_PASSWORD=

# ── Sessions ────────────────────────────────────────────────────────────────
# Longue chaîne aléatoire (ex. `openssl rand -hex 32`). Sert à signer/identifier
# les sessions. La changer déconnecte tout le monde.
SESSION_SECRET=

# ── Identité ────────────────────────────────────────────────────────────────
APP_NAME=MarieNour

# ── Destinataire des notifications (alerte à chaque inscription) ─────────────
# Par défaut binet.antoine2@gmail.com (Gmail). Distinct de ADMIN_EMAIL ci-dessus
# (= identifiant de connexion). Override possible ici si besoin.
# NOTIFY_EMAIL=binet.antoine2@gmail.com

# ── E-mails / SMTP (optionnel) ───────────────────────────────────────────────
# Envoi par SMTP (nodemailer), PRÉ-CÂBLÉ pour Gmail avec binet.antoine2@gmail.com
# comme expéditeur (SMTP_USER par défaut). Il ne reste qu'à poser SMTP_PASS (le
# « mot de passe d'application » Gmail) pour activer l'envoi. Sans SMTP_PASS,
# l'app fonctionne quand même : les e-mails sont simplement désactivés.
#
# Mot de passe d'application Gmail :
#   1. Active la validation en 2 étapes sur le compte Google binet.antoine2@gmail.com.
#   2. Crée un « mot de passe d'application » :
#      https://myaccount.google.com/apppasswords  → 16 caractères.
#   3. Colle-le dans SMTP_PASS ci-dessous.
# SMTP_PASS=xxxxxxxxxxxxxxxx
#
# Réglages SMTP (déjà bons pour Gmail, à changer seulement pour un autre compte/serveur) :
# SMTP_USER=binet.antoine2@gmail.com
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# Expéditeur affiché (Gmail force l'adresse authentifiée ; défaut = SMTP_USER) :
# MAIL_FROM=MarieNour <binet.antoine2@gmail.com>

# ── Réseau (déjà posés par marienour.service, override possible ici) ─────────
# MARIENOUR_PORT=8002
# MARIENOUR_HOST=127.0.0.1
# MARIENOUR_DATA_DIR=/opt/marienour/app/data
