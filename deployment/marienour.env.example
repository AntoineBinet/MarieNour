# marienour — variables d'environnement de PRODUCTION (VM Oracle).
#
# Sur la VM, copier ce fichier vers /etc/marienour/marienour.env, le remplir,
# puis le verrouiller :
#   sudo install -m600 -o root -g root deployment/marienour.env.example /etc/marienour/marienour.env
#   sudo nano /etc/marienour/marienour.env      # remplir les valeurs
#   sudo systemctl restart marienour
#
# ⚠️ NE JAMAIS committer ce fichier rempli. Les secrets restent côté serveur.

# ── Compte admin (toi) ─────────────────────────────────────────────────────
# Au tout premier login avec ADMIN_EMAIL + ADMIN_PASSWORD, le compte admin est
# créé automatiquement (rôle admin garanti). Ensuite, ADMIN_PASSWORD reste le
# « mot de passe maître » du compte propriétaire.
ADMIN_EMAIL=binet.antoine215@yahoo.com
ADMIN_PASSWORD=

# ── Sessions ────────────────────────────────────────────────────────────────
# Longue chaîne aléatoire (ex. `openssl rand -hex 32`). Sert à signer/identifier
# les sessions. La changer déconnecte tout le monde.
SESSION_SECRET=

# ── Identité ────────────────────────────────────────────────────────────────
APP_NAME=marienour

# ── Réseau (déjà posés par marienour.service, override possible ici) ─────────
# MARIENOUR_PORT=8002
# MARIENOUR_HOST=127.0.0.1
# MARIENOUR_DATA_DIR=/opt/marienour/app/data
